# The web container: the Angular app, a same-origin proxy to the APIs, and runtime config for the browser.
# The entrypoint fills ${...} from the environment at start; nginx's own $variables are left alone.

# Paths only, never query strings (PRIV-1).
log_format paths_only '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    include /etc/nginx/conf.d/locations.inc;
}
