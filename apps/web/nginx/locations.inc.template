# Everything a listener serves: the app, /config.json and the /api proxy. Included by the plain-HTTP server in
# default.conf.template and by the HTTPS server the chart adds (deploy/chart/templates/web-tls.yaml), so both
# behave the same. Rendered by the image's entrypoint into /etc/nginx/conf.d/locations.inc (not loaded on its own:
# nginx includes conf.d/*.conf only).
    server_name _;
    root /usr/share/nginx/html;
    access_log /dev/stdout paths_only;
    # proxy_pass with a variable resolves the API name per request, so nginx starts without the APIs. The resolver is
    # the one in /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile); nginx ignores search domains,
    # so upstream names must be fully qualified.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    resolver_timeout 5s;

    location = /health/live { access_log off; default_type text/plain; return 200 "ok\n"; }
    location = /health/ready { access_log off; default_type text/plain; return 200 "ready\n"; }

    # Only the ingest-only browser token reaches the browser (SEC-1).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"dash0Endpoint":"${DASH0_WEB_ENDPOINT}","dash0Token":"${DASH0_BROWSER_TOKEN}","dash0Dataset":"${DASH0_DATASET}","environment":"${ENVIRONMENT}","version":"${SERVICE_VERSION}"}';
    }

    # Dictation: the recording goes to core-api as the request body. nginx's default body limit is 1 MB; the
    # app's own recording limit is 10 MB (PLAN §9.2), and core-api refuses anything larger with 413 as well.
    # The body is streamed to core-api as it arrives (PRIV-1): with nginx's default request buffering, a recording
    # larger than client_body_buffer_size would be spooled to a temporary file under /tmp before being proxied.
    location = /api/v1/dictation {
        client_max_body_size 10m;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        set $core http://${CORE_UPSTREAM};
        proxy_pass $core;
        proxy_set_header Host $host;
    }
    location ~ ^/api/v1/(search|recommendations|ask) {
        set $discovery http://${DISCOVERY_UPSTREAM};
        proxy_pass $discovery;
        proxy_set_header Host $host;
    }
    location /api/ {
        set $core http://${CORE_UPSTREAM};
        proxy_pass $core;
        proxy_set_header Host $host;
    }
    # The CloudBridge replay captions (apps/web/public/media/cloudbridge): nginx's mime.types has no WebVTT entry.
    location ~* \.vtt$ {
        types { }
        default_type text/vtt;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
