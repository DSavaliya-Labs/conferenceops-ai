{
  "components": {
    "schemas": {
      "DictationResponse": {
        "properties": {
          "text": {
            "description": "The recognized text, for the attendee to review; empty when nothing was recognized",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "DictationResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SearchHit": {
        "properties": {
          "conference": {
            "title": "Conference",
            "type": "string"
          },
          "event": {
            "title": "Event",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isFictional": {
            "title": "Isfictional",
            "type": "boolean"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "room": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "startsAt": {
            "format": "date-time",
            "title": "Startsat",
            "type": "string"
          },
          "startsAtVenue": {
            "description": "Start in the event's time zone, e.g. 'Tue Nov 10, 10:30 AM MST'",
            "title": "Startsatvenue",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "topics": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "event",
          "conference",
          "isFictional",
          "startsAt",
          "startsAtVenue"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "conference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Limit to one event, e.g. kubecon-na-2026",
            "title": "Conference"
          },
          "limit": {
            "default": 10,
            "maximum": 25.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "title": "Results",
            "type": "array"
          },
          "retrievalMode": {
            "enum": [
              "hybrid",
              "lexical"
            ],
            "title": "Retrievalmode",
            "type": "string"
          }
        },
        "required": [
          "results",
          "retrievalMode"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ConferenceOps AI API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dictation": {
      "post": {
        "description": "Transcribe one short recording, sent as the request body with its audio media type. The text comes back for the\nattendee to review and edit in the Ask bar; nothing is searched until they submit (PLAN \u00a79.2).",
        "operationId": "dictate_api_v1_dictation_post",
        "requestBody": {
          "content": {
            "audio/m4a": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/mp3": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/mp4": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/mpeg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/ogg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/wav": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/wave": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/webm": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/x-m4a": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "audio/x-wav": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "description": "The recording itself, at most 10 MB and 60 seconds.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "The recording is empty"
          },
          "413": {
            "description": "The recording is larger than the app's limit"
          },
          "415": {
            "description": "The body isn't an audio type the recorder produces"
          },
          "503": {
            "description": "Transcription isn't configured or isn't available; typing still works"
          }
        },
        "summary": "Dictate",
        "tags": [
          "dictation"
        ]
      }
    },
    "/api/v1/search": {
      "post": {
        "description": "Which talks match what I'm interested in? The query arrives in the body, never in the URL (PRIV-1).",
        "operationId": "search_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search"
      }
    },
    "/health/live": {
      "get": {
        "description": "The process is running. Never calls PostgreSQL, Elasticsearch or OpenAI (K8S-1).",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "The process can take traffic. Downstream outages show up as explicit errors, not as unready pods (K8S-1).",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
