{
  "components": {
    "schemas": {
      "AccessStatement": {
        "properties": {
          "kind": {
            "description": "captions, reserved_seating, or step_free_route",
            "title": "Kind",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the event publishes it (ACCESS-1)",
            "title": "Sourceurl"
          },
          "status": {
            "enum": [
              "published",
              "not_published"
            ],
            "title": "Status",
            "type": "string"
          },
          "text": {
            "description": "The event's published wording, or why it isn't published",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "status",
          "text"
        ],
        "title": "AccessStatement",
        "type": "object"
      },
      "AskRequest": {
        "properties": {
          "conference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Limit to one event, e.g. cloudbridge-summit-2026",
            "title": "Conference"
          },
          "limit": {
            "default": 4,
            "description": "How many passages may be cited",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "description": "The question; it travels in the body (PRIV-1)",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "answerSource": {
            "description": "model: written by the model from the cited passages; passages: not model-written, the best-matching passage quoted (the model was slow, down or returned nothing valid)",
            "enum": [
              "model",
              "passages"
            ],
            "title": "Answersource",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "event": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The event the citations come from",
            "title": "Event"
          },
          "isFictional": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Isfictional"
          },
          "retrievalMode": {
            "enum": [
              "hybrid",
              "lexical"
            ],
            "title": "Retrievalmode",
            "type": "string"
          }
        },
        "required": [
          "answer",
          "answerSource",
          "citations",
          "retrievalMode"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "Candidate": {
        "properties": {
          "access": {
            "items": {
              "$ref": "#/components/schemas/AccessStatement"
            },
            "title": "Access",
            "type": "array"
          },
          "conference": {
            "title": "Conference",
            "type": "string"
          },
          "eligibility": {
            "description": "confirmed: every access need the persona set is backed by a published fact. unconfirmed: one can't be confirmed from published information (step-free routes never can); `access` says which.",
            "enum": [
              "confirmed",
              "unconfirmed"
            ],
            "title": "Eligibility",
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "title": "Endsat",
            "type": "string"
          },
          "event": {
            "title": "Event",
            "type": "string"
          },
          "isFictional": {
            "title": "Isfictional",
            "type": "boolean"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "title": "Reasons",
            "type": "array"
          },
          "room": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          },
          "sourceIds": {
            "items": {
              "type": "string"
            },
            "title": "Sourceids",
            "type": "array"
          },
          "sourceRevision": {
            "title": "Sourcerevision",
            "type": "integer"
          },
          "startsAt": {
            "format": "date-time",
            "title": "Startsat",
            "type": "string"
          },
          "startsAtVenue": {
            "description": "Start in the event's time zone, e.g. 'Tue Nov 10, 10:30 AM MST'",
            "title": "Startsatvenue",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "title",
          "event",
          "conference",
          "isFictional",
          "startsAt",
          "endsAt",
          "startsAtVenue",
          "eligibility",
          "score",
          "sourceRevision",
          "access",
          "reasons",
          "sourceIds"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "Citation": {
        "properties": {
          "chunkId": {
            "title": "Chunkid",
            "type": "string"
          },
          "endSeconds": {
            "title": "Endseconds",
            "type": "number"
          },
          "excerpt": {
            "description": "The cited passage, from the published transcript",
            "title": "Excerpt",
            "type": "string"
          },
          "label": {
            "description": "'Simulated excerpt' for synthesized media (SPEAKER-1)",
            "title": "Label",
            "type": "string"
          },
          "replayPath": {
            "description": "The app route of the replay at the cited moment, built by the server",
            "title": "Replaypath",
            "type": "string"
          },
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          },
          "sessionTitle": {
            "title": "Sessiontitle",
            "type": "string"
          },
          "speaker": {
            "title": "Speaker",
            "type": "string"
          },
          "startSeconds": {
            "title": "Startseconds",
            "type": "number"
          }
        },
        "required": [
          "chunkId",
          "sessionId",
          "sessionTitle",
          "speaker",
          "startSeconds",
          "endSeconds",
          "replayPath",
          "excerpt",
          "label"
        ],
        "title": "Citation",
        "type": "object"
      },
      "Cue": {
        "properties": {
          "end": {
            "title": "End",
            "type": "number"
          },
          "start": {
            "description": "Seconds into the replay",
            "title": "Start",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ],
        "title": "Cue",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Notice": {
        "properties": {
          "code": {
            "enum": [
              "STEP_FREE_NOT_PUBLISHED",
              "NO_SIGNALS"
            ],
            "title": "Code",
            "type": "string"
          },
          "sourceUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceurl"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "code",
          "text"
        ],
        "title": "Notice",
        "type": "object"
      },
      "PersonaCard": {
        "description": "A selectable persona: public fields only (PRIV-1).",
        "properties": {
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "interests": {
            "description": "Public professional interests",
            "items": {
              "type": "string"
            },
            "title": "Interests",
            "type": "array"
          },
          "isFictional": {
            "title": "Isfictional",
            "type": "boolean"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "role",
          "isFictional"
        ],
        "title": "PersonaCard",
        "type": "object"
      },
      "PersonaList": {
        "properties": {
          "personas": {
            "items": {
              "$ref": "#/components/schemas/PersonaCard"
            },
            "title": "Personas",
            "type": "array"
          }
        },
        "required": [
          "personas"
        ],
        "title": "PersonaList",
        "type": "object"
      },
      "PublishRequest": {
        "properties": {
          "conference": {
            "description": "The conference the session belongs to, e.g. cloudbridge-summit-2026",
            "title": "Conference",
            "type": "string"
          }
        },
        "required": [
          "conference"
        ],
        "title": "PublishRequest",
        "type": "object"
      },
      "PublishResponse": {
        "properties": {
          "changed": {
            "description": "False when the transcript was already in that state",
            "title": "Changed",
            "type": "boolean"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "sessionId": {
            "title": "Sessionid",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TranscriptStatus"
          }
        },
        "required": [
          "sessionId",
          "status",
          "revision",
          "changed",
          "note"
        ],
        "title": "PublishResponse",
        "type": "object"
      },
      "Reason": {
        "properties": {
          "code": {
            "enum": [
              "INTEREST_MATCH",
              "HISTORY_MATCH",
              "BOOKMARK_MATCH",
              "CAPTIONS_PUBLISHED"
            ],
            "title": "Code",
            "type": "string"
          },
          "interests": {
            "description": "INTEREST_MATCH: the interests the talk mentions",
            "items": {
              "type": "string"
            },
            "title": "Interests",
            "type": "array"
          },
          "relatedSessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "HISTORY_MATCH, BOOKMARK_MATCH: the past talk",
            "title": "Relatedsessionid"
          },
          "similarity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cosine similarity of the two talks' embeddings",
            "title": "Similarity"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "code",
          "text"
        ],
        "title": "Reason",
        "type": "object"
      },
      "RecommendationFilters": {
        "properties": {
          "excludedLevels": {
            "description": "Levels to leave out, on top of the persona's saved exclusions. A request adds exclusions; it never removes a saved one.",
            "items": {
              "enum": [
                "beginner",
                "intermediate",
                "advanced",
                "all"
              ],
              "type": "string"
            },
            "title": "Excludedlevels",
            "type": "array"
          }
        },
        "title": "RecommendationFilters",
        "type": "object"
      },
      "RecommendationRequest": {
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/RecommendationFilters"
          },
          "limit": {
            "default": 3,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional words that refine the ranking among the talks that match the persona's interests or history. Never logged (PRIV-1).",
            "title": "Query"
          },
          "window": {
            "default": "any",
            "description": "today: the rest of the event's current day. tomorrow_morning: the event's next day until noon. any: every session that hasn't started. Days are in the event's time zone (TIME-1).",
            "enum": [
              "today",
              "tomorrow_morning",
              "any"
            ],
            "title": "Window",
            "type": "string"
          }
        },
        "title": "RecommendationRequest",
        "type": "object"
      },
      "RecommendationResponse": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "conferenceTime": {
            "description": "Now on the event's clock (UTC)",
            "format": "date-time",
            "title": "Conferencetime",
            "type": "string"
          },
          "conferenceTimeVenue": {
            "title": "Conferencetimevenue",
            "type": "string"
          },
          "excluded": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "How many retrieved talks each hard rule removed: STARTED, OUTSIDE_WINDOW, ON_AGENDA, AGENDA_CONFLICT, LEVEL_EXCLUDED, CAPTIONS_NOT_PUBLISHED; NO_MATCH counts talks with no interest or history reason. Counts only, never another attendee's data.",
            "title": "Excluded",
            "type": "object"
          },
          "observedAt": {
            "description": "The actual wall-clock time (UTC)",
            "format": "date-time",
            "title": "Observedat",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "retrievalMode": {
            "description": "lexical: the interests and query were matched by keywords only, because the embedding model didn't answer (AI-1). History matching uses stored vectors and needs no model call.",
            "enum": [
              "hybrid",
              "lexical"
            ],
            "title": "Retrievalmode",
            "type": "string"
          },
          "status": {
            "enum": [
              "matches",
              "no_fit"
            ],
            "title": "Status",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Notice"
            },
            "title": "Warnings",
            "type": "array"
          },
          "window": {
            "enum": [
              "today",
              "tomorrow_morning",
              "any"
            ],
            "title": "Window",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "status",
          "retrievalMode",
          "conferenceTime",
          "conferenceTimeVenue",
          "observedAt",
          "window",
          "candidates",
          "excluded",
          "warnings"
        ],
        "title": "RecommendationResponse",
        "type": "object"
      },
      "ReplayMedia": {
        "properties": {
          "captionsUrl": {
            "title": "Captionsurl",
            "type": "string"
          },
          "durationSeconds": {
            "title": "Durationseconds",
            "type": "number"
          },
          "label": {
            "description": "'Simulated excerpt': the media is synthesized for the fictional event (SPEAKER-1)",
            "title": "Label",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "captionsUrl",
          "durationSeconds",
          "label"
        ],
        "title": "ReplayMedia",
        "type": "object"
      },
      "ReplaySession": {
        "properties": {
          "conference": {
            "title": "Conference",
            "type": "string"
          },
          "event": {
            "title": "Event",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isFictional": {
            "title": "Isfictional",
            "type": "boolean"
          },
          "speakers": {
            "items": {
              "type": "string"
            },
            "title": "Speakers",
            "type": "array"
          },
          "startsAtVenue": {
            "title": "Startsatvenue",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "speakers",
          "event",
          "conference",
          "isFictional",
          "startsAtVenue"
        ],
        "title": "ReplaySession",
        "type": "object"
      },
      "ReplayView": {
        "properties": {
          "media": {
            "$ref": "#/components/schemas/ReplayMedia"
          },
          "session": {
            "$ref": "#/components/schemas/ReplaySession"
          },
          "transcript": {
            "$ref": "#/components/schemas/TranscriptView"
          }
        },
        "required": [
          "session",
          "media",
          "transcript"
        ],
        "title": "ReplayView",
        "type": "object"
      },
      "SearchHit": {
        "properties": {
          "conference": {
            "title": "Conference",
            "type": "string"
          },
          "event": {
            "title": "Event",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isFictional": {
            "title": "Isfictional",
            "type": "boolean"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "room": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "startsAt": {
            "format": "date-time",
            "title": "Startsat",
            "type": "string"
          },
          "startsAtVenue": {
            "description": "Start in the event's time zone, e.g. 'Tue Nov 10, 10:30 AM MST'",
            "title": "Startsatvenue",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "topics": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "event",
          "conference",
          "isFictional",
          "startsAt",
          "startsAtVenue"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "conference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Limit to one event, e.g. kubecon-na-2026",
            "title": "Conference"
          },
          "limit": {
            "default": 10,
            "maximum": 25.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "title": "Results",
            "type": "array"
          },
          "retrievalMode": {
            "enum": [
              "hybrid",
              "lexical"
            ],
            "title": "Retrievalmode",
            "type": "string"
          }
        },
        "required": [
          "results",
          "retrievalMode"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "TranscriptStatus": {
        "enum": [
          "processing",
          "published"
        ],
        "title": "TranscriptStatus",
        "type": "string"
      },
      "TranscriptView": {
        "properties": {
          "cues": {
            "description": "Empty until the transcript is published",
            "items": {
              "$ref": "#/components/schemas/Cue"
            },
            "title": "Cues",
            "type": "array"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/TranscriptStatus"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The whole transcript; only when published (TRANSCRIPT-1)",
            "title": "Text"
          }
        },
        "required": [
          "status",
          "revision",
          "label"
        ],
        "title": "TranscriptView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ConferenceOps AI API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ask": {
      "post": {
        "description": "A question answered from published transcripts only, with citations that link to the replay. The question\narrives in the body, never in the URL (PRIV-1).",
        "operationId": "ask_api_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
