# Names only. Never put real values in this file or anywhere in the repository (SEC-1).
# Locally the builder loads them from the macOS Keychain; in Kubernetes they come from Secrets.

# OpenAI (all product AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna            # reasoning model for the Responses API (Ask answers; confirmed Nov 9)
OPENAI_ASK_TIMEOUT_SECONDS=10      # a slower answer falls back to the best-matching passage (AI-1)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Data
DATABASE_URL=                      # postgresql+psycopg://user@host:5432/conferenceops
ELASTICSEARCH_URL=

# Telemetry (Dash0, dataset conferenceops)
OTEL_EXPORTER_OTLP_ENDPOINT=       # the collector inside the cluster
DASH0_DATASET=conferenceops
DASH0_BROWSER_TOKEN=               # ingest-only; the only Dash0 token the browser may see
